PREFIX altr-ext: <http://www.w3.org/ns/dx/connegp/altr-ext#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex: <http://example.org/>
PREFIX exp: <https://example.com/profile/>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

exp:GeoAcGov
    a
        prof:Profile ,
        sh:NodeShape ,
        prez:ObjectProfile ;
    dcterms:description "Displays the status(es) of a Geoprocessing Activity for each register it is registered in" ;
    dcterms:identifier "geoacprov"^^xsd:token ;
    dcterms:title "Geoprocessing Activity Governance Profile" ;
    altr-ext:constrainsClass ex:GeoprocessingActivity ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/ld+json" ,
        "text/anot+turtle" ,
        "text/turtle" ;
    sh:property
        [
            sh:path
                [
                    sh:union (
                        schema:name
                        rdf:type
                         (
                        ex:qualifiedStatus
                        schema:memberOf
                    )
                         (
                        ex:qualifiedStatus
                        schema:value
                    )
                         (
                        ex:qualifiedStatus
                        schema:memberOf
                        prov:qualifiedAttribution
                        prov:agent
                    )
                         (
                        ex:qualifiedStatus
                        schema:memberOf
                        prov:qualifiedAttribution
                        prov:agent
                        schema:name
                    )
                         (
                        ex:qualifiedStatus
                        schema:memberOf
                        prov:qualifiedAttribution
                        prov:hadRole
                    )
                    ) ;
                ] ;
        ] ;
.
